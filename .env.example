# Copy this file to .env and fill in your own values. .env is
# gitignored — never commit real credentials.

# Required for the Gemini/Vertex AI judge (Phase 3). Without these, the
# server logs a warning at startup and runs with the AI judge disabled —
# ambiguous orders are reported as pending instead of failing the run.
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Optional. Vertex AI API-key auth. Omit this line entirely to use
# Application Default Credentials instead (gcloud auth application-default login).
GOOGLE_API_KEY=your-vertex-ai-api-key

# Optional. Defaults to gemini-2.5-flash if unset.
GEMINI_MODEL=gemini-2.5-flash
